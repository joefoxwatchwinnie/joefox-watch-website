<main>
  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow">Product Range</div>
      <h1>Quartz Watches</h1>
      <p>Wholesale quartz timepieces for global distributors, retailers and gift brands. All models support OEM/ODM customization and private-label packaging.</p>
    </div>
  </section>

  <section class="catalog">
    <div class="wrap">
      <div class="product-grid">
        <% products.forEach(p => { %>
        <div class="product-card reveal">
          <div class="product-image">
            <% if(p.image){ %>
              <img src="<%= p.image %>" alt="<%= p.title %>">
            <% } else { %>
              <div class="img-placeholder">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                <span>800×800px<br>Upload product image</span>
              </div>
            <% } %>
          </div>
          <div class="product-body">
            <h3><%= p.title %></h3>
            <div class="product-meta">
              <span><%= p.model %></span>
              <span><%= p.movement %></span>
              <span>MOQ <%= p.moq %></span>
            </div>
            <p><%= p.description %></p>
            <a href="https://wa.me/<%= settings.whatsapp.replace(/\D/g,'') %>?text=Hi%20JOEFOX%2C%20I%20am%20interested%20in%20<%= encodeURIComponent(p.title) %>" target="_blank" rel="noopener" class="btn btn-outline">Inquire Now</a>
          </div>
        </div>
        <% }) %>
      </div>
      <% if(products.length === 0){ %>
        <p class="empty-note">No products yet. Add quartz watch models in the admin panel.</p>
      <% } %>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap reveal">
      <h2 class="section-title">Need a Custom Model?</h2>
      <p>We manufacture private-label quartz watches with your logo, dial and packaging. MOQ from 300 pcs.</p>
      <a href="/oem-odm-service" class="btn btn-light">Explore OEM &amp; ODM</a>
    </div>
  </section>
</main>

<style>
  section{padding:90px 0;}
  .page-hero{background:var(--ink);color:#fff;padding:120px 0 90px;}
  .page-hero .eyebrow{color:rgba(255,255,255,.6);}
  .page-hero h1{font-size:clamp(2rem,5vw,3.4rem);font-weight:700;letter-spacing:-.02em;margin-bottom:14px;}
  .page-hero p{color:rgba(255,255,255,.75);font-size:1.15rem;max-width:680px;}

  .catalog{background:var(--gray-100);}
  .product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;}
  .product-card{background:#fff;border:1px solid var(--gray-300);border-radius:var(--radius);overflow:hidden;transition:.35s var(--ease);display:flex;flex-direction:column;}
  .product-card:hover{transform:translateY(-6px);box-shadow:0 24px 50px -25px rgba(0,0,0,.18);border-color:transparent;}
  .product-image{aspect-ratio:1/1;background:var(--gray-100);position:relative;overflow:hidden;}
  .product-image img{width:100%;height:100%;object-fit:cover;transition:transform .5s var(--ease);}
  .product-card:hover .product-image img{transform:scale(1.06);}
  .img-placeholder{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--gray-500);gap:10px;text-align:center;font-size:.85rem;}
  .product-body{padding:22px;display:flex;flex-direction:column;flex:1;}
  .product-body h3{font-size:1.05rem;font-weight:700;margin-bottom:10px;}
  .product-meta{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px;}
  .product-meta span{font-size:.72rem;color:var(--gray-500);background:var(--gray-100);padding:4px 10px;border-radius:20px;text-transform:uppercase;letter-spacing:.04em;}
  .product-body p{color:var(--gray-700);font-size:.88rem;margin-bottom:18px;flex:1;}
  .product-body .btn{width:100%;}
  .empty-note{text-align:center;color:var(--gray-500);padding:40px 0;}

  .cta-band{background:var(--ink);color:#fff;text-align:center;}
  .cta-band .section-title{color:#fff;}
  .cta-band p{color:rgba(255,255,255,.75);font-size:1.05rem;max-width:560px;margin:14px auto 28px;}

  @media(max-width:1024px){
    .product-grid{grid-template-columns:repeat(3,1fr);}
  }
  @media(max-width:768px){
    section{padding:64px 0;}
    .page-hero{padding:100px 0 64px;}
    .product-grid{grid-template-columns:1fr 1fr;gap:16px;}
    .product-body{padding:16px;}
  }
  @media(max-width:480px){
    .product-grid{grid-template-columns:1fr;}
  }
</style>
