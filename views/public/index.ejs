<main>
  <!-- ========== BLOCK 2: HERO CAROUSEL ========== -->
  <section class="hero" id="top">
    <div class="slides">
      <% banners.forEach((banner, idx) => { %>
      <div class="slide <%= idx === 0 ? 'active' : '' %>" data-index="<%= idx %>">
        <div class="slide-bg" style="<%= banner.image ? `background-image:url('${banner.image}')` : '' %>">
          <% if(!banner.image){ %>
            <div class="upload-prompt">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              <span>Banner <%= idx + 1 %> background image<br>Upload in admin panel</span>
            </div>
          <% } %>
        </div>
        <div class="slide-overlay"></div>
        <div class="wrap">
          <div class="hero-content">
            <% if(banner.subtitle){ %><div class="hero-eyebrow"><%= banner.subtitle %></div><% } %>
            <h1><%= banner.title %></h1>
            <p><%= banner.description %></p>
            <div class="hero-actions">
              <a href="<%= banner.cta_link %>" class="btn btn-light"><%= banner.cta_text %></a>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <div class="hero-dots">
      <% banners.forEach((_, idx) => { %>
        <button class="dot <%= idx === 0 ? 'active' : '' %>" data-index="<%= idx %>" aria-label="Slide <%= idx + 1 %>"></button>
      <% }) %>
    </div>
  </section>

  <!-- ========== BLOCK 3: 4-COLUMN CORE ADVANTAGES ========== -->
  <section class="highlights" id="highlights">
    <div class="wrap">
      <div class="sec-head center reveal">
        <div class="eyebrow">Why Choose JOEFOX</div>
        <h2 class="section-title">Built For Global B2B Buyers</h2>
      </div>
      <div class="hl-grid">
        <% highlights.forEach(h => { %>
        <div class="hl-card reveal">
          <div class="hl-ic"><%- hlIcon(h.icon) %></div>
          <div class="hl-body">
            <h4><%= h.title %></h4>
            <p><%= h.desc %></p>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ========== BLOCK 4: OUR FACTORY PREVIEW ========== -->
  <section class="home-factory" id="factory">
    <div class="wrap">
      <div class="sec-head reveal">
        <div class="eyebrow">About Us</div>
        <h2 class="section-title"><%= factory.title %></h2>
        <p class="section-sub"><%= factory.subtitle %></p>
      </div>
      <div class="factory-grid">
        <div class="factory-media reveal">
          <% if(factory.image){ %>
            <img src="<%= factory.image %>" alt="JOEFOX Factory">
          <% } else { %>
            <div class="media-placeholder">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              <span>Factory image upload slot<br>Recommended 1200×800px</span>
            </div>
          <% } %>
        </div>
        <div class="factory-text reveal">
          <p><%= factory.content %></p>
          <div class="factory-stats">
            <% factory.stats.forEach(s => { %>
              <div class="fstat"><strong><%= s.value %></strong><span><%= s.label %></span></div>
            <% }) %>
          </div>
          <a href="/our-factory" class="btn" style="margin-top:28px;">Learn More About Our Factory</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== BLOCK 5: OEM & ODM SERVICE PREVIEW ========== -->
  <section class="home-oem" id="oem">
    <div class="wrap">
      <div class="sec-head center reveal">
        <div class="eyebrow">Partnership</div>
        <h2 class="section-title"><%= oem.title %></h2>
        <p class="section-sub"><%= oem.subtitle %></p>
      </div>
      <div class="oem-highlights reveal">
        <div class="oh-item">
          <span>OEM Minimum MOQ</span>
          <strong><%= oem.moq %></strong>
        </div>
        <div class="oh-item">
          <span>Fast Sample Production</span>
          <strong>Within <%= oem.sample_lead %></strong>
        </div>
        <div class="oh-item">
          <span>Mass Production Lead Time</span>
          <strong><%= oem.mass_lead %></strong>
        </div>
      </div>
      <p class="home-oem-line reveal"><%= oem.content %></p>
      <div class="reveal" style="text-align:center;">
        <a href="/oem-odm-service" class="btn">Explore OEM &amp; ODM Service</a>
      </div>
    </div>
  </section>

  <!-- ========== BLOCK 6: FEATURED PRODUCTS PREVIEW ========== -->
  <section class="home-products" id="products">
    <div class="wrap">
      <div class="sec-head reveal">
        <div class="eyebrow">Product Range</div>
        <h2 class="section-title">Dual-Movement Sport Watches</h2>
        <p class="section-sub">Analog + digital dual display sport watches, factory-direct wholesale. All models support OEM/ODM customization and private-label packaging.</p>
      </div>
      <div class="product-grid">
        <% featured.forEach(p => { %>
        <div class="product-card reveal">
          <a href="/product/<%= p.id %>" class="product-image">
            <img src="<%= p.image %>" alt="<%= p.model %> <%= p.name %>" loading="lazy" onerror="this.src='/assets/placeholders/product.svg'">
          </a>
          <div class="product-body">
            <h3><%= p.model %> — <%= p.name %></h3>
            <div class="product-meta">
              <span><%= p.title %></span>
              <span>MOQ <%= p.moq_mono || 100 %> pcs</span>
              <% if (p.tiers && p.tiers.length) { %>
                <span>from <%= fmtPrice(p.tiers[p.tiers.length-1].price) %>/pc</span>
              <% } %>
            </div>
            <a href="/product/<%= p.id %>" class="btn btn-outline">View Details & Pricing</a>
          </div>
        </div>
        <% }) %>
      </div>
      <div class="reveal" style="text-align:center;margin-top:44px;display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
        <a href="/products?series=dual-movement" class="btn" >Browse All Dual-Movement Watches</a>
        <a href="/download-catalog" class="btn btn-outline" style="border-color:var(--ink);">Download Catalog (PDF)</a>
      </div>
    </div>
  </section>

  <!-- ========== BLOCK 6B: QUARTZ WATCHES PREVIEW ========== -->
  <section class="home-products" id="quartz" style="background:var(--gray-100);">
    <div class="wrap">
      <div class="sec-head reveal">
        <div class="eyebrow">Quartz Collection</div>
        <h2 class="section-title">Classic Quartz Watches</h2>
        <p class="section-sub">Timeless business &amp; dress quartz watches for men and ladies — silver tone FOB pricing, gold tone and solid steel strap options. 145+ models ready for OEM branding.</p>
      </div>
      <div class="product-grid">
        <% featuredQuartz.forEach(p => { %>
        <div class="product-card reveal">
          <a href="/product/<%= p.id %>" class="product-image">
            <img src="<%= p.image %>" alt="<%= p.model %> <%= p.name %>" loading="lazy" onerror="this.src='/assets/placeholders/product.svg'">
          </a>
          <div class="product-body">
            <h3><%= p.model %> — <%= p.name %></h3>
            <div class="product-meta">
              <span><%= p.title %></span>
              <span>MOQ <%= p.moq_mono || 100 %> pcs</span>
              <% if (p.tiers && p.tiers.length) { %>
                <span>from <%= fmtPrice(p.tiers[p.tiers.length-1].price) %>/pc</span>
              <% } %>
            </div>
            <a href="/product/<%= p.id %>" class="btn btn-outline">View Details & Pricing</a>
          </div>
        </div>
        <% }) %>
      </div>
      <div class="reveal" style="text-align:center;margin-top:44px;">
        <a href="/products?series=quartz" class="btn" >Browse All Quartz Watches</a>
      </div>
    </div>
  </section>

  <!-- ========== DOWNLOAD CATALOG CTA ========== -->
  <section class="catalog-cta">
    <div class="wrap">
      <div class="cc-inner reveal">
        <div class="cc-text">
          <div class="eyebrow">Product Catalog</div>
          <h2 class="section-title">Download Our Full Watch Catalog</h2>
          <p class="section-sub">Get the complete JOEFOX wholesale &amp; OEM product catalog with specs, MOQ and pricing guidance. Perfect for importers, distributors and brand owners.</p>
        </div>
        <a href="/download-catalog" class="btn btn-light">Download Catalog (PDF)</a>
      </div>
    </div>
  </section>
</main>

<style>
  /* Hero */
  .hero{position:relative;height:88vh;min-height:560px;max-height:900px;overflow:hidden;background:var(--ink);}
  .slides{position:absolute;inset:0;}
  .slide{position:absolute;inset:0;opacity:0;visibility:hidden;transition:opacity .9s var(--ease),visibility .9s;display:flex;align-items:center;}
  .slide.active{opacity:1;visibility:visible;}
  .slide-bg{position:absolute;inset:0;background-size:cover;background-position:center;background-color:#1a1a1a;}
  .slide-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.65),rgba(0,0,0,.2) 70%,transparent);}
  .upload-prompt{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:rgba(255,255,255,.35);gap:16px;text-align:center;}
  .hero-content{position:relative;z-index:2;color:#fff;max-width:640px;text-shadow:0 2px 28px rgba(0,0,0,.45);}
  .hero-eyebrow{font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.7);margin-bottom:14px;font-weight:600;}
  .hero-content h1{font-size:clamp(1.55rem,3vw,2.4rem);font-weight:600;line-height:1.3;letter-spacing:-.01em;margin-bottom:14px;}
  .hero-content p{font-size:.95rem;color:rgba(255,255,255,.78);max-width:470px;font-weight:300;line-height:1.65;}
  .hero-actions{display:flex;gap:12px;margin-top:26px;flex-wrap:wrap;}
  .hero-dots{position:absolute;bottom:36px;left:0;right:0;z-index:3;display:flex;justify-content:center;gap:12px;}
  .dot{width:40px;height:3px;background:rgba(255,255,255,.3);border:none;cursor:pointer;transition:.3s;}
  .dot.active{background:#fff;}
  .btn-outline-light{background:transparent;color:#fff;border-color:rgba(255,255,255,.5);}
  .btn-outline-light:hover{background:#fff;color:var(--ink);border-color:#fff;}

  /* Section spacing */
  section{padding:90px 0;}
  .sec-head{margin-bottom:48px;}
  .sec-head.center{text-align:center;}
  .sec-head.center .section-sub{margin-left:auto;margin-right:auto;}

  /* Highlights (single row, 3 columns) */
  .highlights{background:var(--white);}
  .hl-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;}
  .hl-card{background:var(--gray-100);border:1px solid var(--gray-300);border-radius:var(--radius);padding:32px 34px;transition:.3s var(--ease);display:flex;align-items:flex-start;gap:20px;}
  .hl-card:hover{border-color:var(--ink);transform:translateY(-4px);box-shadow:0 20px 40px -25px rgba(0,0,0,.15);}
  .hl-ic{width:48px;height:48px;flex:0 0 48px;border-radius:12px;background:var(--ink);color:#fff;display:flex;align-items:center;justify-content:center;}
  .hl-ic svg{width:24px;height:24px;}
  .hl-body{min-width:0;}
  .hl-card h4{font-size:1.05rem;font-weight:700;margin-bottom:8px;white-space:nowrap;}
  .hl-card p{color:var(--gray-700);font-size:.88rem;line-height:1.55;}

  /* Factory preview */
  .home-factory{background:var(--gray-100);}
  .factory-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:60px;align-items:center;}
  .factory-media{border-radius:var(--radius);overflow:hidden;background:var(--white);border:1px solid var(--gray-300);min-height:420px;}
  .factory-media img{width:100%;height:100%;object-fit:cover;}
  .media-placeholder{height:420px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--gray-500);gap:14px;text-align:center;}
  .factory-text p{color:var(--gray-700);font-size:1.05rem;}
  .factory-stats{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:26px;}
  .fstat{background:#fff;border:1px solid var(--gray-300);border-radius:var(--radius);padding:18px;}
  .fstat strong{display:block;font-size:1.5rem;font-weight:700;color:var(--ink);}
  .fstat span{font-size:.78rem;color:var(--gray-500);text-transform:uppercase;letter-spacing:.06em;}

  /* OEM preview */
  .home-oem{background:var(--white);}
  .oem-highlights{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-bottom:28px;}
  .oh-item{background:var(--gray-100);border:1px solid var(--gray-300);border-radius:var(--radius);padding:26px;text-align:center;}
  .oh-item span{display:block;font-size:.8rem;color:var(--gray-500);text-transform:uppercase;letter-spacing:.08em;margin-bottom:8px;}
  .oh-item strong{font-size:1.5rem;font-weight:700;color:var(--ink);}
  .home-oem-line{max-width:720px;margin:0 auto 32px;text-align:center;color:var(--gray-700);font-size:1.05rem;}

  /* Products preview */
  .home-products{background:var(--gray-100);}
  .product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;}

  /* Catalog CTA */
  .catalog-cta{background:var(--ink);color:#fff;}
  .cc-inner{display:flex;align-items:center;justify-content:space-between;gap:40px;flex-wrap:wrap;}
  .cc-text{max-width:640px;}
  .cc-text .eyebrow{color:rgba(255,255,255,.6);}
  .cc-text .section-title{color:#fff;}
  .cc-text .section-sub{color:rgba(255,255,255,.7);}
  .product-card{background:#fff;border:1px solid var(--gray-300);border-radius:var(--radius);overflow:hidden;transition:.35s var(--ease);display:flex;flex-direction:column;}
  .product-card:hover{transform:translateY(-6px);box-shadow:0 24px 50px -25px rgba(0,0,0,.18);border-color:transparent;}
  .product-image{display:block;aspect-ratio:1/1;background:var(--gray-100);position:relative;overflow:hidden;}
  .product-image img{width:100%;height:100%;object-fit:cover;transition:transform .5s var(--ease);}
  .product-card:hover .product-image img{transform:scale(1.06);}
  .img-placeholder{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--gray-500);gap:10px;text-align:center;font-size:.85rem;}
  .product-body{padding:22px;display:flex;flex-direction:column;flex:1;}
  .product-body h3{font-size:1.05rem;font-weight:700;margin-bottom:10px;}
  .product-meta{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px;}
  .product-meta span{font-size:.72rem;color:var(--gray-500);background:var(--gray-100);padding:4px 10px;border-radius:20px;text-transform:uppercase;letter-spacing:.04em;}
  .product-body p{color:var(--gray-700);font-size:.88rem;margin-bottom:18px;flex:1;}
  .product-body .btn{width:100%;}

  @media(max-width:1024px){
    .product-grid{grid-template-columns:repeat(2,1fr);}
    .hl-grid{grid-template-columns:1fr;}
    .hl-card h4{white-space:normal;}
    .oem-highlights{grid-template-columns:1fr;}
  }
  @media(max-width:768px){
    .hero{height:70vh;min-height:480px;}
    .slide-overlay{background:linear-gradient(180deg,rgba(0,0,0,.6),rgba(0,0,0,.4));}
    section{padding:64px 0;}
    .factory-grid{grid-template-columns:1fr;gap:36px;}
    .factory-media,.media-placeholder{min-height:280px;}
    .product-grid{grid-template-columns:1fr 1fr;gap:16px;}
    .product-body{padding:16px;}
    .factory-stats{grid-template-columns:1fr 1fr;}
    .hero-actions{flex-direction:column;gap:10px;}
    .hero-actions .btn{width:100%;justify-content:center;}
  }
  @media(max-width:560px){
    .hl-grid{grid-template-columns:1fr;}
    .product-grid{grid-template-columns:1fr;}
  }
</style>

<% function hlIcon(name){
  const m = {
    shipping: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h1"/><path d="M14 9h4l4 4v4a1 1 0 0 1-1 1h-1"/><circle cx="7.5" cy="18.5" r="1.6"/><circle cx="17.5" cy="18.5" r="1.6"/></svg>',
    water: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5S5.5 9.5 5.5 14a6.5 6.5 0 0 0 13 0C18.5 9.5 12 2.5 12 2.5z"/></svg>',
    movement: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>',
    return: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h11a4 4 0 0 1 0 8H9"/><path d="M6 5L3 8l3 3"/></svg>',
    oem: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7.5l9-5 9 5v9l-9 5-9-5z"/><path d="M3 7.5l9 5 9-5"/><path d="M12 12.5v9"/></svg>'
  };
  return m[name] || m.shipping;
} %>

<script>
  // Hero carousel
  const slides = document.querySelectorAll('.hero .slide');
  const dots = document.querySelectorAll('.hero .dot');
  let current = 0, timer;
  function show(i){
    slides[current].classList.remove('active');
    dots[current].classList.remove('active');
    current = (i + slides.length) % slides.length;
    slides[current].classList.add('active');
    dots[current].classList.add('active');
  }
  function next(){ show(current + 1); }
  function start(){ timer = setInterval(next, 6000); }
  function stop(){ clearInterval(timer); }
  dots.forEach((d, i) => d.addEventListener('click', () => { show(i); stop(); start(); }));
  const hero = document.querySelector('.hero');
  if(hero){ hero.addEventListener('mouseenter', stop); hero.addEventListener('mouseleave', start); start(); }
</script>
