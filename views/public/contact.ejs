<main>
  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow">Get Started</div>
      <h1><%= contact.title %></h1>
      <p><%= contact.subtitle %></p>
    </div>
  </section>

  <section class="contact-section">
    <div class="wrap">
      <div class="contact-grid">
        <div class="contact-info-card reveal">
          <h3>Reach Us Directly</h3>
          <p class="lead"><%= contact.content %></p>
          <ul class="contact-list">
            <li>
              <span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm5.5 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.2-.7-2.8-1.2-4.6-4.1-4.7-4.3-.1-.2-1.1-1.5-1.1-2.8 0-1.3.7-1.9.9-2.2.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.3 0 .5l-.4.5c-.1.2-.2.3-.1.5.1.2.5.9 1 1.5.7.7 1.3 1 1.5 1.1.2.1.3.1.4-.1l.5-.7c.2-.2.3-.2.5-.1l1.9.9c.2.1.4.2.4.3.1.1.1.6-.1 1.2z"/></svg></span>
              <div><strong>WhatsApp</strong><a href="https://wa.me/<%= settings.whatsapp.replace(/\D/g,'') %>" target="_blank" rel="noopener"><%= settings.whatsapp %></a></div>
            </li>
            <li>
              <span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M4 7l8 6 8-6"/></svg></span>
              <div><strong>Email</strong><a href="mailto:<%= settings.email %>"><%= settings.email %></a></div>
            </li>
            <li>
              <span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11z"/><circle cx="12" cy="10" r="2.4"/></svg></span>
              <div><strong>Factory Address</strong><span><%= settings.address %></span></div>
            </li>
          </ul>
          <div class="contact-actions">
            <a href="https://wa.me/<%= settings.whatsapp.replace(/\D/g,'') %>" target="_blank" rel="noopener" class="btn btn-light">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm5.5 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.2-.7-2.8-1.2-4.6-4.1-4.7-4.3-.1-.2-1.1-1.5-1.1-2.8 0-1.3.7-1.9.9-2.2.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.3 0 .5l-.4.5c-.1.2-.2.3-.1.5.1.2.5.9 1 1.5.7.7 1.3 1 1.5 1.1.2.1.3.1.4-.1l.5-.7c.2-.2.3-.2.5-.1l1.9.9c.2.1.4.2.4.3.1.1.1.6-.1 1.2z"/></svg>
              Chat on WhatsApp
            </a>
            <a href="mailto:<%= settings.email %>" class="btn btn-outline-light">Email Us</a>
          </div>
        </div>

        <div class="contact-form-card reveal">
          <h3>Quick Inquiry</h3>
          <p class="lead">Send your requirements and we will reply with catalog &amp; quotation within 24 hours.</p>
          <form method="post" action="/inquiry">
            <div class="form-row two">
              <div>
                <label>Name *</label>
                <input type="text" name="name" required>
              </div>
              <div>
                <label>Company</label>
                <input type="text" name="company">
              </div>
            </div>
            <div class="form-row two">
              <div>
                <label>Email *</label>
                <input type="email" name="email" required>
              </div>
              <div>
                <label>Phone / WhatsApp</label>
                <input type="text" name="phone">
              </div>
            </div>
            <div class="form-row two">
              <div>
                <label>Country / Region</label>
                <input type="text" name="country">
              </div>
              <div>
                <label>Product of Interest</label>
                <select name="product_id">
                  <option value="">— General inquiry —</option>
                  <% products.forEach(p => { %>
                    <option value="<%= p.id %>" <%= preselect===p.id?'selected':'' %>><%= p.model %> — <%= p.name %></option>
                  <% }) %>
                </select>
              </div>
            </div>
            <div class="form-row">
              <label>Estimated Quantity</label>
              <input type="text" name="quantity" placeholder="e.g. 500 pcs">
            </div>
            <div class="form-row">
              <label>Message *</label>
              <textarea name="message" rows="4" required placeholder="Model, quantity, target price, OEM/logo customization needs..."></textarea>
            </div>
            <div class="form-actions">
              <button type="submit" class="btn" style="width:100%;">Send Inquiry</button>
              <a href="https://wa.me/<%= settings.whatsapp.replace(/\D/g,'') %>" target="_blank" rel="noopener" class="btn btn-wa" style="width:100%;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm5.5 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.2-.7-2.8-1.2-4.6-4.1-4.7-4.3-.1-.2-1.1-1.5-1.1-2.8 0-1.3.7-1.9.9-2.2.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.3 0 .5l-.4.5c-.1.2-.2.3-.1.5.1.2.5.9 1 1.5.7.7 1.3 1 1.5 1.1.2.1.3.1.4-.1l.5-.7c.2-.2.3-.2.5-.1l1.9.9c.2.1.4.2.4.3.1.1.1.6-.1 1.2z"/></svg>
                Chat on WhatsApp instead
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</main>

<style>
  section{padding:90px 0;}
  .page-hero{background:var(--ink);color:#fff;padding:120px 0 90px;}
  .page-hero .eyebrow{color:rgba(255,255,255,.6);}
  .page-hero h1{font-size:clamp(2rem,5vw,3.4rem);font-weight:700;letter-spacing:-.02em;margin-bottom:14px;}
  .page-hero p{color:rgba(255,255,255,.75);font-size:1.15rem;max-width:640px;}

  .contact-section{background:var(--gray-100);}
  .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:start;}
  .contact-info-card,.contact-form-card{background:#fff;border:1px solid var(--gray-300);border-radius:var(--radius);padding:40px;}
  .contact-info-card h3,.contact-form-card h3{font-size:1.4rem;font-weight:700;margin-bottom:10px;}
  .lead{color:var(--gray-700);font-size:1.02rem;margin-bottom:24px;}
  .contact-list{margin-bottom:28px;}
  .contact-list li{display:flex;gap:14px;align-items:flex-start;padding:14px 0;border-bottom:1px solid var(--gray-300);}
  .contact-list li:last-child{border-bottom:none;}
  .contact-list .ic{color:var(--ink);flex:0 0 20px;margin-top:2px;}
  .contact-list strong{display:block;font-size:.78rem;text-transform:uppercase;letter-spacing:.06em;color:var(--gray-500);margin-bottom:2px;}
  .contact-list a,.contact-list span{color:var(--ink);font-size:.98rem;}
  .contact-list a:hover{text-decoration:underline;}
  .contact-actions{display:flex;gap:12px;flex-wrap:wrap;}
  .btn-outline-light{background:transparent;color:var(--ink);border-color:var(--gray-300);}
  .btn-outline-light:hover{background:var(--ink);color:#fff;border-color:var(--ink);}

  .form-row{margin-bottom:18px;}
  .form-row.two{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  .form-row label{display:block;font-size:.82rem;font-weight:600;color:var(--gray-700);margin-bottom:7px;}
  .form-row input,.form-row textarea,.form-row select{width:100%;border:1px solid var(--gray-300);border-radius:var(--radius);padding:12px 14px;font-size:.95rem;font-family:inherit;background:var(--gray-100);transition:.2s;}
  .form-row input:focus,.form-row textarea:focus,.form-row select:focus{outline:none;border-color:var(--ink);background:#fff;}
  .form-actions{display:flex;flex-direction:column;gap:10px;}

  @media(max-width:768px){
    section{padding:64px 0;}
    .page-hero{padding:100px 0 64px;}
    .contact-grid{grid-template-columns:1fr;gap:24px;}
    .contact-info-card,.contact-form-card{padding:28px;}
    .form-row.two{grid-template-columns:1fr;}
  }
</style>
