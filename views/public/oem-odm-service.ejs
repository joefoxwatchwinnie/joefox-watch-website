<main>
  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow">Partnership</div>
      <h1><%= oem.title %></h1>
      <p><%= oem.subtitle %></p>
    </div>
  </section>

  <section class="oem-stats">
    <div class="wrap">
      <div class="oem-highlights reveal">
        <div class="oh-item">
          <span>OEM Minimum MOQ</span>
          <strong><%= oem.moq %></strong>
        </div>
        <div class="oh-item">
          <span>Fast Sample Production</span>
          <strong>Within <%= oem.sample_lead %></strong>
        </div>
        <div class="oh-item">
          <span>Mass Production Lead Time</span>
          <strong><%= oem.mass_lead %></strong>
        </div>
      </div>
    </div>
  </section>

  <section class="oem-feature">
    <div class="wrap">
      <div class="feature-box reveal">
        <div class="eyebrow">Customization</div>
        <p class="feature-line"><%= oem.content %></p>
        <a href="/contact" class="btn">Start Your OEM Project</a>
      </div>
    </div>
  </section>

  <section class="oem-services">
    <div class="wrap">
      <div class="sec-head center reveal">
        <div class="eyebrow">What We Offer</div>
        <h2 class="section-title">Full-Service OEM &amp; ODM</h2>
      </div>
      <div class="oem-grid">
        <% oem.services.forEach((svc, idx) => { %>
        <div class="oem-card reveal">
          <div class="oem-img"><img src="<%= svc.image || '/assets/placeholders/product.svg' %>" alt="<%= svc.title %>" loading="lazy"></div>
          <div class="oem-body">
            <div class="oem-ic"><%= idx + 1 %></div>
            <h4><%= svc.title %></h4>
            <p><%= svc.desc %></p>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap reveal">
      <h2 class="section-title">Build Your Watch Brand With JOEFOX</h2>
      <p>Send us your logo, design idea or reference sample — we handle the rest from sampling to shipment.</p>
      <a href="/contact" class="btn btn-light">Contact Us</a>
    </div>
  </section>
</main>

<style>
  section{padding:90px 0;}
  .page-hero{background:var(--ink);color:#fff;padding:120px 0 90px;}
  .page-hero .eyebrow{color:rgba(255,255,255,.6);}
  .page-hero h1{font-size:clamp(2rem,5vw,3.4rem);font-weight:700;letter-spacing:-.02em;margin-bottom:14px;}
  .page-hero p{color:rgba(255,255,255,.75);font-size:1.15rem;max-width:640px;}

  .oem-stats{background:var(--white);padding-top:80px;padding-bottom:0;}
  .oem-highlights{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  .oh-item{background:var(--gray-100);border:1px solid var(--gray-300);border-radius:var(--radius);padding:30px;text-align:center;}
  .oh-item span{display:block;font-size:.8rem;color:var(--gray-500);text-transform:uppercase;letter-spacing:.08em;margin-bottom:8px;}
  .oh-item strong{font-size:1.6rem;font-weight:700;color:var(--ink);}

  .oem-feature{background:var(--white);}
  .feature-box{background:var(--ink);color:#fff;border-radius:var(--radius);padding:56px 40px;text-align:center;}
  .feature-box .eyebrow{color:rgba(255,255,255,.6);}
  .feature-line{font-size:clamp(1.2rem,3vw,1.7rem);font-weight:600;line-height:1.4;max-width:820px;margin:14px auto 28px;}

  .oem-services{background:var(--gray-100);}
  .sec-head{margin-bottom:48px;}
  .sec-head.center{text-align:center;}
  .oem-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
  .oem-card{background:#fff;border:1px solid var(--gray-300);border-radius:var(--radius);overflow:hidden;transition:.3s var(--ease);display:flex;flex-direction:column;}
  .oem-card:hover{border-color:var(--ink);transform:translateY(-4px);box-shadow:0 20px 40px -25px rgba(0,0,0,.15);}
  .oem-img{aspect-ratio:4/3;overflow:hidden;background:var(--gray-100);}
  .oem-img img{width:100%;height:100%;object-fit:cover;filter:grayscale(100%);transition:filter .5s ease,transform .5s ease;}
  .oem-card:hover .oem-img img{filter:grayscale(0%);transform:scale(1.04);}
  .oem-img.noimg{display:flex;align-items:center;justify-content:center;color:var(--gray-500);font-size:.8rem;}
  .oem-body{padding:20px 22px 26px;flex:1;}
  .oem-ic{width:42px;height:42px;border-radius:50%;background:var(--ink);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;margin-bottom:16px;}
  .oem-card h4{font-size:1.05rem;font-weight:700;margin-bottom:8px;}
  .oem-card p{color:var(--gray-700);font-size:.9rem;line-height:1.6;}

  .cta-band{background:var(--ink);color:#fff;text-align:center;}
  .cta-band .section-title{color:#fff;}
  .cta-band p{color:rgba(255,255,255,.75);font-size:1.05rem;max-width:560px;margin:14px auto 28px;}

  @media(max-width:1024px){
    .oem-grid{grid-template-columns:repeat(2,1fr);}
  }
  @media(max-width:768px){
    section{padding:64px 0;}
    .page-hero{padding:100px 0 64px;}
    .oem-highlights{grid-template-columns:1fr;}
    .feature-box{padding:40px 24px;}
    .oem-grid{grid-template-columns:1fr;}
  }
</style>
