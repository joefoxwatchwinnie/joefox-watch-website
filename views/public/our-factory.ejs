<%
  const F = (typeof factoryPage !== 'undefined' && factoryPage) ? factoryPage : {};
  const gv = (path, fb) => {
    const parts = path.split('.');
    let cur = F;
    for (const k of parts) { if (cur === undefined || cur === null) return fb; cur = cur[k]; }
    return (cur === undefined || cur === null || cur === '') ? fb : cur;
  };
  const hero = gv('hero', {});
  const stats = gv('stats', factory.stats || []);
  const aboutPills = Array.isArray(gv('about.pills', [])) ? gv('about.pills', []) : [];
  const customItems = Array.isArray(gv('process.custom_items', [])) ? gv('process.custom_items', []) : [];
  const qcImages = gv('qc.images', []);
%>
<main class="factory-page">
  <!-- HERO -->
  <section class="fz-hero">
    <div class="wrap">
      <div class="fz-eyebrow"><%= hero.eyebrow || 'JOEFOX Watch Factory' %></div>
      <h1 class="fz-title"><%= gv('hero.title', factory.title || 'Our Factory') %></h1>
      <p class="fz-sub"><%= gv('hero.subtitle', factory.subtitle || '') %></p>
    </div>
    <div class="fz-hero-img">
      <img src="<%= gv('hero.image', '/uploads/factory/production-line.jpg') %>" alt="JOEFOX watch production line">
    </div>
    <div class="fz-stats wrap">
      <% stats.forEach(s => { %>
        <div class="fz-stat"><strong><%= s.value %></strong><span><%= s.label %></span></div>
      <% }) %>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="fz-about">
    <div class="wrap fz-about-grid">
      <div class="fz-about-text reveal">
        <div class="fz-eyebrow dark"><%= gv('about.eyebrow', 'About Us') %></div>
        <h2><%= gv('about.heading', 'A comprehensive watch manufacturer') %></h2>
        <p><%= gv('about.content', factory.content || '') %></p>
        <ul class="fz-pills">
          <% aboutPills.forEach(pill => { %><li><%= pill %></li><% }) %>
        </ul>
      </div>
      <div class="fz-about-media reveal">
        <img src="<%= gv('about.image', '/uploads/factory/craft-hands.jpg') %>" alt="Watch assembly craftsmanship">
      </div>
    </div>
  </section>

  <!-- MILESTONES -->
  <section class="fz-dark">
    <div class="wrap">
      <div class="fz-eyebrow"><%= gv('milestones.eyebrow', 'Company Milestones') %></div>
      <h2 class="fz-h2"><%= gv('milestones.heading', 'Our journey') %></h2>
      <div class="fz-timeline">
        <% (gv('milestones.items', []) || []).forEach(ms => { %>
        <div class="fz-ms reveal">
          <div class="fz-year"><%= ms.year %></div>
          <h4><%= ms.title %></h4>
          <p><%= ms.text %></p>
        </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="fz-white">
    <div class="wrap">
      <div class="fz-eyebrow dark"><%= gv('why.eyebrow', 'Why Choose Us') %></div>
      <h2 class="fz-h2"><%= gv('why.heading', 'Your long-term OEM & ODM partner') %></h2>
      <div class="fz-why-grid">
        <% (gv('why.items', []) || []).forEach(w => { %>
        <div class="fz-why reveal">
          <div class="fz-num"><%= w.no || '' %></div>
          <h4><%= w.title %></h4>
          <p><%= w.text %></p>
        </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- MANUFACTURING CAPABILITIES -->
  <section class="fz-cap">
    <div class="wrap">
      <div class="fz-eyebrow"><%= gv('capabilities.eyebrow', 'Manufacturing Capabilities') %></div>
      <h2 class="fz-h2"><%= gv('capabilities.heading', 'Scalable production capacity') %></h2>
      <div class="fz-cap-grid">
        <% (gv('capabilities.items', []) || []).forEach(c => { %>
        <figure class="fz-photo reveal">
          <img src="<%= c.image %>" alt="<%= c.label %>">
          <figcaption><span><%= c.tag %></span><%= c.label %></figcaption>
        </figure>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- QUALITY MANAGEMENT -->
  <section class="fz-dark">
    <div class="wrap">
      <div class="fz-eyebrow"><%= gv('qc.eyebrow', 'Quality Management') %></div>
      <h2 class="fz-h2"><%= gv('qc.heading', 'Multi-layer inspection process') %></h2>
      <div class="fz-qc-grid">
        <div class="fz-qc-steps">
          <% (gv('qc.steps', []) || []).forEach((s, i) => { %>
          <div class="fz-qc-step reveal"><span class="qc-no">0<%= i+1 %></span><div><h4><%= s.title %></h4><p><%= s.text %></p></div></div>
          <% }) %>
        </div>
        <div class="fz-qc-media reveal">
          <% qcImages.forEach(img => { %><img src="<%= img %>" alt="Quality inspection"><% }) %>
        </div>
      </div>
    </div>
  </section>

  <!-- OEM & ODM PROCESS -->
  <section class="fz-white">
    <div class="wrap">
      <div class="fz-eyebrow dark"><%= gv('process.eyebrow', 'OEM & ODM Process') %></div>
      <h2 class="fz-h2"><%= gv('process.heading', 'Full-cycle brand customization') %></h2>
      <div class="fz-proc-grid">
        <% (gv('process.steps', []) || []).forEach((s, i) => { %>
        <div class="fz-proc reveal">
          <div class="fz-num">0<%= i+1 %></div>
          <h4><%= s.title %></h4>
          <p><%= s.text %></p>
        </div>
        <% }) %>
      </div>
      <div class="fz-custom reveal">
        <div class="fz-eyebrow dark" style="margin-bottom:16px;"><%= gv('process.custom_label', 'Customizable Support Items') %></div>
        <ul class="fz-pills">
          <% customItems.forEach(item => { %><li><%= item %></li><% }) %>
        </ul>
      </div>
    </div>
  </section>

  <!-- TRUSTED BY -->
  <section class="fz-trust">
    <div class="wrap fz-trust-grid">
      <div class="fz-trust-media reveal">
        <img src="<%= gv('trust.image', '/uploads/factory/walmart.jpg') %>" alt="Global hypermarket partnership">
      </div>
      <div class="fz-trust-text reveal">
        <div class="fz-eyebrow dark"><%= gv('trust.eyebrow', 'OEM Success Stories') %></div>
        <h2 class="fz-h2"><%= gv('trust.heading', 'Trusted by global brands') %></h2>
        <% (gv('trust.clients', []) || []).forEach(c => { %>
        <div class="fz-client">
          <h3><%= c.name %></h3>
          <p><%= c.text %></p>
        </div>
        <% }) %>
        <p class="fz-trust-note"><%= gv('trust.note', '') %></p>
      </div>
    </div>
  </section>

  <!-- DUBAI SHOWROOM -->
  <section class="fz-dubai">
    <div class="wrap">
      <div class="fz-dubai-head reveal">
        <div>
          <div class="fz-eyebrow dark"><%= gv('dubai.eyebrow', 'Global Retail Presence') %></div>
          <h2 class="fz-h2" style="margin-bottom:0;"><%= gv('dubai.heading', 'Our Dubai Showroom') %></h2>
        </div>
        <p class="fz-dubai-sub"><%= gv('dubai.text', '') %></p>
      </div>
      <div class="fz-dubai-grid">
        <% const dubaiImgs = gv('dubai.images', []) || []; const dubaiCaps = gv('dubai.captions', []) || []; %>
        <% if (dubaiImgs[0]) { %>
        <figure class="fz-dubai-photo featured reveal">
          <img src="<%= dubaiImgs[0] %>" alt="JOEFOX Dubai showroom storefront, Deira">
          <figcaption><span><%= dubaiCaps[0] || 'Storefront' %></span>Deira, Dubai · U.A.E</figcaption>
        </figure>
        <% } %>
        <% if (dubaiImgs[1]) { %>
        <figure class="fz-dubai-photo reveal">
          <img src="<%= dubaiImgs[1] %>" alt="Dubai showroom retail shelves">
          <figcaption><span><%= dubaiCaps[1] || 'Retail Shelves' %></span>Full JOEFOX range in stock</figcaption>
        </figure>
        <% } %>
        <% if (dubaiImgs[2]) { %>
        <figure class="fz-dubai-photo reveal">
          <img src="<%= dubaiImgs[2] %>" alt="Dubai showroom aisle">
          <figcaption><span><%= dubaiCaps[2] || 'Showroom Aisle' %></span>Thousands of models on display</figcaption>
        </figure>
        <% } %>
        <% if (dubaiImgs[3]) { %>
        <figure class="fz-dubai-photo wide reveal">
          <img src="<%= dubaiImgs[3] %>" alt="Dubai showroom display wall">
          <figcaption><span><%= dubaiCaps[3] || 'Display Wall' %></span>Quartz & dual-movement collections</figcaption>
        </figure>
        <% } %>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-band">
    <div class="wrap reveal">
      <h2 class="section-title"><%= gv('cta.title', 'Ready to Cooperate?') %></h2>
      <p><%= gv('cta.text', 'Contact our sales team for a tailored quotation.') %></p>
      <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
        <a href="/contact" class="btn btn-light">Contact Us</a>
        <a href="/sample-request" class="btn" style="background:transparent;border:1px solid rgba(255,255,255,.4);color:#fff;">Request a Sample</a>
      </div>
    </div>
  </section>
</main>

<style>
  /* ===== 黑白高级调性 ===== */
  .factory-page{background:var(--white);}
  .factory-page section{padding:0;}
  .fz-eyebrow{font-size:.75rem;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.55);margin-bottom:20px;}
  .fz-eyebrow.dark{color:var(--gray-500);}
  .fz-h2{font-size:clamp(1.7rem,3.6vw,2.6rem);font-weight:700;letter-spacing:-.02em;line-height:1.18;margin-bottom:44px;}
  .fz-photo img,.fz-about-media img,.fz-hero-img img,.fz-qc-media img,.fz-trust-media img{filter:grayscale(100%);transition:filter .6s ease;}
  .fz-photo:hover img,.fz-about-media:hover img,.fz-qc-media:hover img,.fz-trust-media:hover img{filter:grayscale(0%);}

  /* HERO */
  .fz-hero{background:var(--ink);color:#fff;padding:130px 0 0 !important;}
  .fz-title{font-size:clamp(2.2rem,5vw,3.8rem);font-weight:700;letter-spacing:-.02em;line-height:1.15;margin-bottom:22px;}
  .fz-sub{color:rgba(255,255,255,.6);font-size:1.1rem;max-width:620px;line-height:1.65;}
  .fz-hero-img{margin-top:64px;}
  .fz-hero-img img{width:100%;height:min(52vh,460px);object-fit:cover;display:block;}
  .fz-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.14);border-top:none;}
  .fz-stat{background:var(--ink);padding:26px 18px;text-align:center;}
  .fz-stat strong{display:block;font-size:1.7rem;font-weight:700;color:#fff;}
  .fz-stat span{font-size:.72rem;color:rgba(255,255,255,.55);text-transform:uppercase;letter-spacing:.08em;}

  /* ABOUT */
  .fz-about{padding:100px 0 !important;background:var(--white);}
  .fz-about-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;}
  .fz-about-text h2{font-size:clamp(1.6rem,3.2vw,2.3rem);font-weight:700;letter-spacing:-.02em;margin-bottom:18px;}
  .fz-about-text p{color:var(--gray-700);font-size:1.05rem;line-height:1.75;}
  .fz-about-media img{width:100%;aspect-ratio:3/4;object-fit:cover;display:block;}
  .fz-pills{list-style:none;display:flex;flex-wrap:wrap;gap:10px;margin-top:24px;padding:0;}
  .fz-pills li{font-size:.8rem;font-weight:600;letter-spacing:.04em;border:1px solid var(--gray-300);padding:8px 16px;color:var(--ink);}

  /* DARK SECTIONS */
  .fz-dark{background:var(--ink);color:#fff;padding:100px 0 !important;}
  .fz-dark .fz-h2{color:#fff;}
  .fz-timeline{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.14);}
  .fz-ms{background:var(--ink);padding:30px 24px 36px;}
  .fz-year{font-size:2rem;font-weight:700;letter-spacing:-.02em;margin-bottom:12px;color:#fff;}
  .fz-year::after{content:"";display:block;width:32px;height:2px;background:#fff;margin-top:12px;}
  .fz-ms h4{font-size:.95rem;font-weight:600;margin-bottom:8px;color:#fff;}
  .fz-ms p{font-size:.85rem;line-height:1.6;color:rgba(255,255,255,.6);}

  /* WHY */
  .fz-white{padding:100px 0 !important;background:var(--white);}
  .fz-why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;border-top:1px solid var(--gray-300);padding-top:40px;}
  .fz-num{font-size:2.4rem;font-weight:300;letter-spacing:-.02em;color:var(--gray-300);margin-bottom:14px;font-variant-numeric:tabular-nums;}
  .fz-why h4,.fz-proc h4{font-size:1.05rem;font-weight:700;margin-bottom:10px;}
  .fz-why p,.fz-proc p{font-size:.9rem;line-height:1.7;color:var(--gray-700);}

  /* CAPABILITIES */
  .fz-cap{padding:100px 0 !important;background:var(--gray-100);}
  .fz-cap-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--gray-300);border:1px solid var(--gray-300);}
  .fz-photo{margin:0;background:#fff;position:relative;}
  .fz-photo img{width:100%;aspect-ratio:3/4;object-fit:cover;display:block;}
  .fz-photo figcaption{padding:16px 18px;font-size:.85rem;font-weight:600;color:var(--ink);}
  .fz-photo figcaption span{display:block;font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gray-500);margin-bottom:4px;font-weight:600;}

  /* QC */
  .fz-qc-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start;}
  .fz-qc-step{display:flex;gap:20px;padding:22px 0;border-bottom:1px solid rgba(255,255,255,.14);}
  .fz-qc-step:last-child{border-bottom:none;}
  .qc-no{font-size:1.1rem;font-weight:300;color:rgba(255,255,255,.4);flex:0 0 36px;font-variant-numeric:tabular-nums;}
  .fz-qc-step h4{font-size:1rem;font-weight:600;color:#fff;margin-bottom:5px;}
  .fz-qc-step p{font-size:.85rem;line-height:1.6;color:rgba(255,255,255,.6);}
  .fz-qc-media{display:grid;gap:16px;}
  .fz-qc-media img{width:100%;aspect-ratio:3/4;object-fit:cover;display:block;}

  /* PROCESS */
  .fz-proc-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:40px;border-top:1px solid var(--gray-300);padding-top:40px;}
  .fz-custom{margin-top:64px;border-top:1px solid var(--gray-300);padding-top:40px;}

  /* TRUST */
  .fz-trust{padding:100px 0 !important;background:var(--white);border-top:1px solid var(--gray-200);}
  .fz-trust-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:64px;align-items:center;}
  .fz-trust-media img{width:100%;aspect-ratio:3/4;object-fit:cover;display:block;}
  .fz-client{border-top:1px solid var(--gray-300);padding:20px 0 6px;margin-top:8px;}
  .fz-client h3{font-size:1.3rem;font-weight:700;letter-spacing:.02em;margin-bottom:6px;}
  .fz-client p{font-size:.92rem;color:var(--gray-700);line-height:1.6;}
  .fz-trust-note{margin-top:22px;font-size:.9rem;color:var(--gray-500);font-style:italic;}

  /* DUBAI SHOWROOM */
  .fz-dubai{padding:100px 0 !important;background:var(--gray-100);}
  .fz-dubai-head{display:flex;justify-content:space-between;align-items:flex-end;gap:40px;margin-bottom:44px;flex-wrap:wrap;}
  .fz-dubai-sub{max-width:460px;font-size:.98rem;line-height:1.7;color:var(--gray-700);}
  .fz-dubai-grid{display:grid;grid-template-columns:1.05fr 1fr 1fr;grid-auto-rows:250px;gap:16px;}
  .fz-dubai-photo{margin:0;position:relative;overflow:hidden;border-radius:var(--radius);background:var(--ink);}
  .fz-dubai-photo.featured{grid-row:1/3;}
  .fz-dubai-photo.wide{grid-column:2/4;}
  .fz-dubai-photo img{width:100%;height:100%;object-fit:cover;display:block;filter:grayscale(100%);transition:filter .55s ease,transform .55s ease;}
  .fz-dubai-photo:hover img{filter:grayscale(0%);transform:scale(1.035);}
  .fz-dubai-photo figcaption{position:absolute;left:0;right:0;bottom:0;padding:34px 18px 14px;background:linear-gradient(transparent,rgba(0,0,0,.72));color:#fff;font-size:.85rem;font-weight:600;display:flex;flex-direction:column;gap:2px;}
  .fz-dubai-photo figcaption span{font-size:.64rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.75);font-weight:700;}
  .fz-dubai-photo::after{content:"";position:absolute;inset:0;border:1px solid rgba(255,255,255,.12);border-radius:var(--radius);pointer-events:none;transition:.4s;}
  .fz-dubai-photo:hover::after{border-color:rgba(255,255,255,.4);}

  .cta-band{padding:90px 0 !important;}

  @media(max-width:960px){
    .fz-timeline{grid-template-columns:1fr 1fr;}
    .fz-why-grid{grid-template-columns:1fr;gap:28px;}
    .fz-cap-grid{grid-template-columns:1fr 1fr;}
    .fz-proc-grid{grid-template-columns:1fr 1fr;gap:28px;}
    .fz-qc-grid{grid-template-columns:1fr;}
    .fz-about-grid,.fz-trust-grid{grid-template-columns:1fr;gap:36px;}
    .fz-stats{grid-template-columns:1fr 1fr;}
    .fz-dubai-grid{grid-template-columns:1fr 1fr;grid-auto-rows:220px;}
    .fz-dubai-photo.featured{grid-row:auto;}
    .fz-dubai-photo.wide{grid-column:1/3;}
  }
  @media(max-width:560px){
    .fz-timeline{grid-template-columns:1fr;}
    .fz-cap-grid{grid-template-columns:1fr;}
    .fz-proc-grid{grid-template-columns:1fr;}
    .fz-hero{padding-top:110px;}
    .fz-hero-img img{height:280px;}
    .fz-about-media img{height:280px;}
    .fz-trust-media img{height:260px;}
    .fz-dubai-grid{grid-template-columns:1fr;grid-auto-rows:230px;}
    .fz-dubai-photo.wide{grid-column:auto;}
  }
</style>
