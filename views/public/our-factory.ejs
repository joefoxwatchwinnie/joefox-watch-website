<main>
  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow">About Us</div>
      <h1><%= factory.title %></h1>
      <p><%= factory.subtitle %></p>
    </div>
  </section>

  <section class="factory-detail">
    <div class="wrap">
      <div class="factory-grid">
        <div class="factory-media reveal">
          <% if(factory.image){ %>
            <img src="<%= factory.image %>" alt="JOEFOX Factory">
          <% } else { %>
            <div class="media-placeholder">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              <span>Factory image upload slot<br>Recommended 1200×800px</span>
            </div>
          <% } %>
        </div>
        <div class="factory-text reveal">
          <p><%= factory.content %></p>
          <a href="/contact" class="btn" style="margin-top:8px;">Request Factory Tour</a>
        </div>
      </div>
      <div class="factory-stats-row reveal">
        <% factory.stats.forEach(s => { %>
          <div class="fstat"><strong><%= s.value %></strong><span><%= s.label %></span></div>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="why">
    <div class="wrap">
      <div class="sec-head center reveal">
        <div class="eyebrow">Why Choose JOEFOX</div>
        <h2 class="section-title">A Manufacturing Partner You Can Trust</h2>
      </div>
      <div class="adv-grid">
        <% advantages.forEach(adv => { %>
        <div class="adv-item reveal">
          <div class="adv-check">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5L20 7"/></svg>
          </div>
          <div>
            <h4><%= adv.title %></h4>
            <p><%= adv.desc %></p>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap reveal">
      <h2 class="section-title">Ready to Visit or Cooperate?</h2>
      <p>Contact our sales team for factory videos, certifications and a tailored quotation.</p>
      <a href="/contact" class="btn btn-light">Contact Us</a>
    </div>
  </section>
</main>

<style>
  section{padding:90px 0;}
  .page-hero{background:var(--ink);color:#fff;padding:120px 0 90px;}
  .page-hero .eyebrow{color:rgba(255,255,255,.6);}
  .page-hero h1{font-size:clamp(2rem,5vw,3.4rem);font-weight:700;letter-spacing:-.02em;margin-bottom:14px;}
  .page-hero p{color:rgba(255,255,255,.75);font-size:1.15rem;max-width:640px;}

  .factory-detail{background:var(--white);}
  .factory-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:60px;align-items:center;}
  .factory-media{border-radius:var(--radius);overflow:hidden;background:var(--gray-100);border:1px solid var(--gray-300);min-height:440px;}
  .factory-media img{width:100%;height:100%;object-fit:cover;}
  .media-placeholder{height:440px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--gray-500);gap:14px;text-align:center;}
  .factory-text p{color:var(--gray-700);font-size:1.1rem;line-height:1.7;}
  .factory-stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:60px;}
  .fstat{background:var(--gray-100);border:1px solid var(--gray-300);border-radius:var(--radius);padding:26px;text-align:center;}
  .fstat strong{display:block;font-size:1.9rem;font-weight:700;color:var(--ink);}
  .fstat span{font-size:.8rem;color:var(--gray-500);text-transform:uppercase;letter-spacing:.07em;}

  .why{background:var(--gray-100);}
  .sec-head{margin-bottom:48px;}
  .sec-head.center{text-align:center;}
  .sec-head.center .section-sub{margin-left:auto;margin-right:auto;}
  .adv-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
  .adv-item{background:#fff;border:1px solid var(--gray-300);border-radius:var(--radius);padding:24px;display:flex;gap:16px;align-items:flex-start;transition:.3s;}
  .adv-item:hover{border-color:var(--ink);}
  .adv-check{width:32px;height:32px;border-radius:50%;background:var(--ink);color:#fff;display:flex;align-items:center;justify-content:center;flex:0 0 32px;}
  .adv-item h4{font-size:1rem;font-weight:700;margin-bottom:4px;}
  .adv-item p{color:var(--gray-700);font-size:.9rem;line-height:1.6;}

  .cta-band{background:var(--ink);color:#fff;text-align:center;}
  .cta-band .section-title{color:#fff;}
  .cta-band p{color:rgba(255,255,255,.75);font-size:1.05rem;max-width:560px;margin:14px auto 28px;}

  @media(max-width:900px){
    .factory-stats-row{grid-template-columns:1fr 1fr;}
  }
  @media(max-width:768px){
    section{padding:64px 0;}
    .page-hero{padding:100px 0 64px;}
    .factory-grid{grid-template-columns:1fr;gap:32px;}
    .factory-media,.media-placeholder{min-height:280px;}
    .adv-grid{grid-template-columns:1fr;}
  }
  @media(max-width:480px){
    .factory-stats-row{grid-template-columns:1fr;}
  }
</style>
