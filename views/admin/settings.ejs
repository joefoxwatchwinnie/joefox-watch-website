<h1>Site Settings</h1>

<form method="POST" action="/admin/settings" enctype="multipart/form-data" class="card">
  <div class="two-col">
    <div class="form-group">
      <label>Site Title</label>
      <input type="text" name="site_title" value="<%= settings.site_title %>" required>
    </div>
    <div class="form-group">
      <label>WhatsApp Number</label>
      <input type="text" name="whatsapp" value="<%= settings.whatsapp %>" required>
    </div>
  </div>

  <div class="two-col">
    <div class="form-group">
      <label>Email</label>
      <input type="email" name="email" value="<%= settings.email %>" required>
    </div>
    <div class="form-group">
      <label>Factory Address</label>
      <input type="text" name="address" value="<%= settings.address %>" required>
    </div>
  </div>

  <div class="form-group">
    <label>Meta Description</label>
    <textarea name="meta_description"><%= settings.meta_description %></textarea>
  </div>

  <div class="two-col">
    <div class="form-group">
      <label>Site URL (for SEO / sitemap)</label>
      <input type="text" name="site_url" value="<%= settings.site_url || '' %>" placeholder="https://www.joefoxwatchofficial.com">
    </div>
    <div class="form-group">
      <label>Default Display Currency</label>
      <select name="currency_default">
        <% Object.keys(settings.currency_rates || { CNY: 1 }).forEach(c => { %>
          <option value="<%= c %>" <%= (settings.currency_default || 'USD') === c ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
    </div>
  </div>

  <h2>Multi-Currency Rates (base: CNY 1.00)</h2>
  <p class="hint" style="margin-bottom:12px;">Visitors switch currency in the navigation bar. Prices in the catalog are converted using these rates — update them to match your quotations.</p>
  <div class="form-group">
    <label>Rates JSON (currency → CNY rate)</label>
    <textarea name="currency_rates" rows="3"><%= JSON.stringify(settings.currency_rates || {}) %></textarea>
  </div>
  <div class="form-group">
    <label>Symbols JSON (currency → prefix symbol)</label>
    <textarea name="currency_symbols" rows="3"><%= JSON.stringify(settings.currency_symbols || {}) %></textarea>
  </div>

  <h2>Inquiry Email Notification (SMTP)</h2>
  <p class="hint" style="margin-bottom:12px;">When configured, every website inquiry sends (1) a notification to your email and (2) an auto-reply to the customer. Leave empty to disable — inquiries are always archived in "Inquiries & Samples". Example host: smtp.gmail.com, port 465, secure on.</p>
  <div class="two-col">
    <div class="form-group">
      <label>SMTP Host</label>
      <input type="text" name="smtp_host" value="<%= settings.smtp_host || '' %>" placeholder="smtp.gmail.com">
    </div>
    <div class="form-group">
      <label>SMTP Port</label>
      <input type="text" name="smtp_port" value="<%= settings.smtp_port || '465' %>">
    </div>
  </div>
  <div class="two-col">
    <div class="form-group">
      <label>SMTP User</label>
      <input type="text" name="smtp_user" value="<%= settings.smtp_user || '' %>" placeholder="you@gmail.com">
    </div>
    <div class="form-group">
      <label>SMTP Password / App Password</label>
      <input type="password" name="smtp_pass" value="" placeholder="<%= settings.smtp_pass ? '(unchanged)' : 'leave empty if not changing' %>">
    </div>
  </div>
  <div class="two-col">
    <div class="form-group">
      <label>From Address (optional)</label>
      <input type="text" name="smtp_from" value="<%= settings.smtp_from || '' %>">
    </div>
    <div class="form-group">
      <label>Use SSL/TLS (port 465)</label>
      <select name="smtp_secure">
        <option value="1" <%= settings.smtp_secure !== '0' ? 'selected' : '' %>>Yes (recommended)</option>
        <option value="0" <%= settings.smtp_secure === '0' ? 'selected' : '' %>>No (STARTTLS, port 587)</option>
      </select>
    </div>
  </div>

  <h2>Logo Uploads</h2>
    <p class="hint" style="margin-bottom:16px;">Upload a transparent PNG. "Dark background logo" is used on the dark hero banner; "Light background logo" is used on the white navigation bar. If you only have a white logo, check "Invert nav logo" below so it becomes dark on the white nav.</p>

    <div class="form-group toggle">
      <label><input type="checkbox" name="logo_invert" value="1" <%= settings.logo_invert ? 'checked' : '' %>> Invert navigation logo colors (use when logo file is white)</label>
    </div>

    <div class="two-col">
    <div class="form-group">
      <label>Logo for Dark Backgrounds</label>
      <input type="file" name="logo_dark" accept="image/*">
      <% if(settings.logo_dark){ %>
        <div style="margin-top:10px;">
          <img src="<%= settings.logo_dark %>" class="preview" alt="Dark logo">
          <p class="hint"><%= settings.logo_dark %></p>
        </div>
      <% } else { %>
        <div class="preview-placeholder" style="margin-top:10px;">No image</div>
      <% } %>
    </div>
    <div class="form-group">
      <label>Logo for Light Backgrounds</label>
      <input type="file" name="logo_light" accept="image/*">
      <% if(settings.logo_light){ %>
        <div style="margin-top:10px;">
          <img src="<%= settings.logo_light %>" class="preview" alt="Light logo">
          <p class="hint"><%= settings.logo_light %></p>
        </div>
      <% } else { %>
        <div class="preview-placeholder" style="margin-top:10px;">No image</div>
      <% } %>
    </div>
  </div>

  <h2>Product Catalog PDF (Download)</h2>
  <p class="hint" style="margin-bottom:16px;">Upload your watch product catalog PDF. Visitors can download it from the "Download Catalog" button on the homepage and in the website footer. Accepted format: PDF (max 25 MB).</p>
  <div class="form-group">
    <label>Catalog PDF File</label>
    <input type="file" name="catalog_pdf" accept="application/pdf">
    <% if(settings.catalog_pdf){ %>
      <div style="margin-top:10px;">
        <a href="<%= settings.catalog_pdf %>" target="_blank" class="preview"><%= settings.catalog_pdf %></a>
        <label class="toggle" style="margin-top:8px;display:block;"><input type="checkbox" name="remove_catalog" value="1"> Remove current catalog</label>
      </div>
    <% } else { %>
      <div class="preview-placeholder" style="margin-top:10px;">No PDF uploaded</div>
    <% } %>
  </div>

  <button type="submit" class="btn">Save Settings</button>
</form>
