<h1>Product Catalog</h1>
<p class="hint" style="margin-bottom:20px;">78 products seeded from the JOEFOX dual-movement price catalog. Edit tier pricing, MOQ and specs at any time.</p>

<input type="text" id="prodSearch" placeholder="Filter by model / name..." style="max-width:320px;margin-bottom:16px;">

<div class="card">
  <h2>Add New Product</h2>
  <form method="POST" action="/admin/products/add" enctype="multipart/form-data">
    <%- include('_product_fields', { p: null }) %>
    <div class="two-col">
      <div class="form-group">
        <label>Sort Order</label>
        <input type="number" name="sort_order" value="<%= products.length + 1 %>">
      </div>
      <div class="form-group">
        <label>Product Image</label>
        <input type="file" name="image" accept="image/*">
      </div>
    </div>
    <button type="submit" class="btn">Add Product</button>
  </form>
</div>

<div class="card">
  <h2>Product List (<%= products.length %>)</h2>
  <table>
    <tr><th>Image</th><th>Model / Name</th><th>Series</th><th>MOQ</th><th>Tiers</th><th>Sort</th><th>Active</th><th>Actions</th></tr>
    <% products.forEach(p => { %>
    <tr class="prod-row" data-search="<%= (p.model + ' ' + p.name + ' ' + p.title).toLowerCase() %>">
      <td>
        <% if(p.image){ %>
          <img src="<%= p.image %>" class="preview" alt="<%= p.model %>">
        <% } else { %>
          <div class="preview-placeholder">No image</div>
        <% } %>
      </td>
      <td>
        <strong><%= p.model %> <%= p.name || '' %></strong><br>
        <span class="hint"><%= p.title || p.description?.slice(0,60) || '—' %></span>
      </td>
      <td><%= p.series || '—' %></td>
      <td><%= p.moq_mono || p.moq || '—' %><%= p.moq_mixed ? ' / ' + p.moq_mixed : '' %></td>
      <td><%= (p.tiers || []).length ? p.tiers.map(t => t.qty + ':' + t.price).join('<br>') : '—' %></td>
      <td><%= p.sort_order %></td>
      <td><%= p.active ? 'Yes' : 'No' %></td>
      <td>
        <button class="btn btn-sm btn-secondary" onclick="toggleEdit('<%= p.id %>')">Edit</button>
        <form method="POST" action="/admin/products/<%= p.id %>/delete" style="display:inline;" onsubmit="return confirm('Delete this product?')">
          <button type="submit" class="btn btn-sm btn-danger">Delete</button>
        </form>
      </td>
    </tr>
    <tr id="edit-<%= p.id %>" style="display:none;background:#fafafa;">
      <td colspan="8" style="padding:20px;">
        <form method="POST" action="/admin/products/<%= p.id %>" enctype="multipart/form-data">
          <%- include('_product_fields', { p: p }) %>
          <div class="two-col">
            <div class="form-group">
              <label>Sort Order</label>
              <input type="number" name="sort_order" value="<%= p.sort_order %>">
            </div>
            <div class="form-group">
              <label>Replace Image</label>
              <input type="file" name="image" accept="image/*">
            </div>
          </div>
          <div class="form-group toggle">
            <label><input type="checkbox" name="active" <%= p.active ? 'checked' : '' %>> Active</label>
          </div>
          <button type="submit" class="btn">Save Product</button>
        </form>
      </td>
    </tr>
    <% }) %>
  </table>
</div>

<script>
  function toggleEdit(id) {
    const row = document.getElementById('edit-' + id);
    row.style.display = row.style.display === 'none' ? 'table-row' : 'none';
  }
  document.getElementById('prodSearch').addEventListener('input', function() {
    const q = this.value.toLowerCase();
    document.querySelectorAll('.prod-row').forEach(r => {
      r.style.display = r.dataset.search.includes(q) ? '' : 'none';
    });
  });
</script>
