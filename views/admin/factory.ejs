<h1>Our Factory</h1>

<form method="POST" action="/admin/factory" enctype="multipart/form-data" class="card">
  <div class="two-col">
    <div class="form-group">
      <label>Section Title</label>
      <input type="text" name="title" value="<%= factory.title %>" required>
    </div>
    <div class="form-group">
      <label>Subtitle</label>
      <input type="text" name="subtitle" value="<%= factory.subtitle %>" required>
    </div>
  </div>

  <div class="form-group">
    <label>Content</label>
    <textarea name="content" rows="5" required><%= factory.content %></textarea>
  </div>

  <h2>Factory Stats</h2>
  <div class="four-col">
    <% factory.stats.forEach((stat, idx) => { %>
    <div class="form-group">
      <label>Stat <%= idx + 1 %> Value</label>
      <input type="text" name="stat_value_<%= idx %>" value="<%= stat.value %>">
      <label style="margin-top:8px;">Label</label>
      <input type="text" name="stat_label_<%= idx %>" value="<%= stat.label %>">
    </div>
    <% }) %>
  </div>

  <h2>Factory Image</h2>
  <div class="form-group">
    <input type="file" name="image" accept="image/*">
    <% if(factory.image){ %>
      <div style="margin-top:10px;">
        <img src="<%= factory.image %>" class="preview" alt="Factory">
        <p class="hint"><%= factory.image %></p>
      </div>
    <% } else { %>
      <div class="preview-placeholder" style="margin-top:10px;">No image uploaded</div>
    <% } %>
  </div>

  <button type="submit" class="btn">Save Factory Section</button>
</form>
